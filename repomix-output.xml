                                  labelText: 'تُطبق كل',
                                  suffixText: 'أشهر',
                                  border: const OutlineInputBorder(),
                                  filled: true,
                                  fillColor: canEdit
                                      ? Colors.white
                                      : Colors.grey.shade100,
                                  prefixIcon: const Icon(
                                    Icons.update,
                                    color: Colors.deepOrange,
