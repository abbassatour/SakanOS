    // فك تشفير المعاملات بأمان
    Map<String, dynamic> coefficientsMap = {};
    if (contract.coefficients.isNotEmpty && contract.coefficients != '{}') {
      try {
        coefficientsMap = jsonDecode(contract.coefficients);
      } catch (_) {}
    }

    // استخراج بيانات الغرامة بأمان
