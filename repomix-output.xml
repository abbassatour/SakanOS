                                                ],
                                              ),
                                            ],
                                          ),
                                        ),
                                        
                                        // خط فاصل خفيف
                                        Container(width: 1, height: 50, color: Colors.grey.shade200, margin: const EdgeInsets.symmetric(horizontal: 12)),
                                        
                                        // ==========================================
                                        // 🌟 [التعديل 2]: حالة الديون المتأخرة والغرامات
                                        // ==========================================
                                        Expanded(
                                          flex: 2, // تم التوسيع لتستوعب الأرقام الكبيرة
                                          child: Column(
