                    ),
                    onPressed: () async {
                      final isAuth = await showVerifyPinDialog(parentCtx);
                      if (!isAuth) return;
                      if (!parentCtx.mounted) return;
                      ScaffoldMessenger.of(parentCtx).showSnackBar(
                        SnackBar(
                          content: Text(
                            isCompleted
                                ? 'جاري فتح العقد...'
                                : 'جاري إغلاق وأرشفة العقد...',
