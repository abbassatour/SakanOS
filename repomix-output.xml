                                      .read<ContractsCubit>()
                                      .attachContractFile(
                                        contractId: contract.id,
                                        filePath: filePath,
                                        extension: extension,
                                      );
                                  if (parentCtx.mounted) {
                                    ScaffoldMessenger.of(parentCtx)
                                        .showSnackBar(
                                      const SnackBar(
                                        content: Text(
                                          'تم استبدال الملف بنجاح! ✅',
                                        ),
                                        backgroundColor: Colors.green,
                                      ),
                                    );
