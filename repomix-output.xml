                  fillColor: Colors.white,
                ),
              ),
            ],
          ),
        ),
      );
    }
    return widgets;
  }

  void _handleSave() {
    if (_nameCtrl.text.trim().isEmpty) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('⚠️ الرجاء إدخال اسم المحضر!'),
          backgroundColor: Colors.red,
        ),
      );
      return;
    }

    final finalFloorCoeffs = <String, double>{};
