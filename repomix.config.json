{
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml"
  },
  "ignore": {
    "customPatterns": [
      "**/*.g.dart",
      "**/*.freezed.dart",
      "android/**",
      "ios/**",
      "web/**",
      "macos/**",
      "windows/**",
      "linux/**",
      "**/pubspec.lock",
      "Redist/**",
      "ourhomesetup.iss",
      ".github/**",
      "**/*.svg",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.webp",
      "**/*.gif",
      "**/*.ico",
      "**/README.md",
      "**/CHANGELOG.md",
      "LICENSE",
      ".dart_tool/**",
      "build/**",
      ".idea/**",
      ".vscode/**",
      ".flutter-plugins",
      ".flutter-plugins-dependencies",
      ".metadata",
      "repomix-output.xml",
      
      "/* --- الاستثناءات الإضافية المقترحة لمشروعك --- */",
      "Output/**",
      "**/*.exe",
      "**/*.msi",
      "**/*.md",
      "repomix.config.json",
      ".coderabbit.yaml",
      "**/.gitignore",
      "analysis_options.yaml",
      "devtools_options.yaml",
      "l10n.yaml",
      "**/*.ttf",
      "**/*.otf",

      "test/**",
      "Tenant Router"
    ]
  }
}